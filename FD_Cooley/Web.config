<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode"
             value="None" />
	</appSettings>

	<connectionStrings>
		<add name="DessertDB"
             connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=FavoriteDessertDB;Integrated Security=True"
             providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" />
	</system.web>

	<system.webServer>
		<defaultDocument enabled="true">
			<files>
				<clear />
				<add value="FavoriteDessert.aspx" />
			</files>
		</defaultDocument>
	</system.webServer>
</configuration>